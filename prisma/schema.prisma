generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Unified User model that combines authentication and profile data
model User {
  id            String     @id @default(cuid())
  // Authentication fields
  email         String     @unique
  emailVerified DateTime?
  password      String?
  role          UserRole   @default(VOLUNTEER)
  status        UserStatus @default(PENDING)

  // Profile fields (previously in TeamMember)
  firstName        String?
  lastName         String?
  name             String? // Computed from firstName + lastName
  avatar           String?
  bio              String?
  jobTitle         String?
  department       String?
  phone            String?
  nationalId       String?
  startDate        DateTime?
  endDate          DateTime?
  location         String?
  district         String?
  region           String?
  languages        String?
  skills           String?
  emergencyContact String?
  availability     Availability?
  weeklyHours      Int?          @default(40)

  // Authentication relations
  accounts Account[]
  sessions Session[]

  // Application relations
  timeEntries        TimeEntry[]
  tasks              TaskAssignee[]
  documents          Document[]
  projectMemberships ProjectMember[]
  projectsOwned      Project[]       @relation("ProjectOwner")
  projectsLed        Project[]       @relation("ProjectLead")
  comments           TaskComment[]
  tasksCreated       Task[]          @relation("TaskCreator")
  checkIns           CheckIn[]
  teams              UserTeam[] // New: User team memberships

  // Finance relations
  stipends                Stipend[]
  stipendsApproved        Stipend[]               @relation("StipendApproval")
  expenseRequests         ExpenseRequest[]        @relation("ExpenseRequester")
  expenseTeamLead         ExpenseRequest[]        @relation("ExpenseTeamLead")
  expenseFinanceApproval  ExpenseRequest[]        @relation("ExpenseFinanceApproval")
  expenseDirectorApproval ExpenseRequest[]        @relation("ExpenseDirectorApproval")
  expenseAttachments      ExpenseAttachment[]
  expenseComments         ExpenseComment[]
  budgetsCreated          DepartmentBudget[]      @relation("BudgetCreator")
  budgetsModified         DepartmentBudget[]      @relation("BudgetModifier")
  budgetAdjustments       BudgetAdjustment[]
  reportsGenerated        FinancialReport[]
  // Project Management relations
  milestoneResponsible    ProjectMilestone[]      @relation("MilestoneResponsible")
  progressUpdates         ProjectProgressUpdate[] @relation("ProgressUpdateUser")
  progressApprovals       ProjectProgressUpdate[] @relation("ProgressApprover")
  projectActivities       ProjectActivityLog[]    @relation("ProjectActivityUser")
  projectResources        ProjectResource[]       @relation("ProjectResourceUser")
  milestoneAttachments    MilestoneAttachment[]

  // Employee Management relations
  employeeProfile    EmployeeProfile?
  createdEmployees   EmployeeProfile[]   @relation("EmployeeCreatedBy")
  uploadedDocuments  EmployeeDocument[]
  performanceReviews PerformanceReview[]
  approvedLeaves     LeaveRequest[]
  privateNotes       PrivateNote[]
  timelineEvents     TimelineEvent[]
  welcomeNotes       WelcomeNote[]
  activityLogs       ActivityLog[]

  // Enhanced Attendance & Work Tracking relations
  dailyTaskLogs    DailyTaskLog[]
  approvedTaskLogs DailyTaskLog[] @relation("TaskLogApprover")
  workSummaries    WorkSummary[]

  // Enhanced Performance & Evaluation relations
  kpisCreated     KPI[]        @relation("KPICreator")
  reviews360Given Review360[]  @relation("Review360Reviewer")
  rewards         UserReward[]
  rewardsGranted  UserReward[] @relation("RewardGranter")

  // Communication relations
  chatChannelsCreated     ChatChannel[]             @relation("ChatChannelCreator")
  chatMemberships         ChatMember[]
  chatMessages            ChatMessage[]
  messageReactions        MessageReaction[]
  pinnedMessages          PinnedMessage[]
  announcements           Announcement[]
  announcementComments    AnnouncementComment[]
  announcementReactions   AnnouncementReaction[]
  announcementViews       AnnouncementView[]
  bulletinBoards          BulletinBoard[]
  bulletinPosts           BulletinPost[]
  bulletinComments        BulletinComment[]
  bulletinViews           BulletinView[]
  pollsCreated            Poll[]
  pollVotes               PollVote[]
  pollComments            PollComment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  communicationAnalytics  CommunicationAnalytics[]

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("UserApproval", fields: [approvedById], references: [id])
  approvedUsers User[]    @relation("UserApproval")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  SUPER_ADMIN
  CEO
  CFO
  ADMIN
  DIRECTOR
  HR_OFFICER
  TEAM_LEAD
  STAFF
  VOLUNTEER
}

enum UserStatus {
  PENDING // Awaiting admin approval
  ACTIVE // Approved and active
  INACTIVE // Temporarily deactivated
  SUSPENDED // Suspended by admin
  REJECTED // Application rejected
}

enum Availability {
  FULL_TIME
  PART_TIME
  ON_CALL
  FLEXIBLE
}

// Task model for assignments
model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime? // Start of the deadline range
  endDate     DateTime? // End of the deadline range
  priority    TaskPriority     @default(MEDIUM)
  status      TaskStatus       @default(NOT_STARTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  createdById String?
  createdBy   User?            @relation("TaskCreator", fields: [createdById], references: [id])
  attachments TaskAttachment[]
  comments    TaskComment[]
  timeEntries TimeEntry[]
  completedAt DateTime?
  assignees   TaskAssignee[] // Individual user assignments
  teams       TaskTeam[] // Team assignments
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// Task attachments model
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Task comments model
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Time tracking model
model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  duration    Int? // Duration in minutes
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

// Project model
model Project {
  id                  String                  @id @default(cuid())
  name                String                  @db.VarChar(100)
  description         String?
  status              ProjectStatus           @default(PLANNING)
  priority            ProjectPriority         @default(MEDIUM)
  startDate           DateTime?
  endDate             DateTime?
  budget              Float?
  clientId            String?
  client              Client?                 @relation(fields: [clientId], references: [id])
  ownerId             String
  owner               User                    @relation("ProjectOwner", fields: [ownerId], references: [id])
  colorTag            String?
  department          String? // Department dropdown: Outreach, Therapy, IT, Media, Research, etc.
  projectLeadId       String? // Project Lead from existing employee list
  projectLead         User?                   @relation("ProjectLead", fields: [projectLeadId], references: [id])
  googleDriveFolderId String? // Google Drive folder integration
  notionPageId        String? // Notion page integration
  team                ProjectMember[]
  tasks               Task[]
  documents           Document[]
  transactions        FinancialTransaction[]
  expenses            ExpenseRequest[]
  milestones          ProjectMilestone[] // Project milestones
  progressUpdates     ProjectProgressUpdate[] // Daily progress updates
  activityLogs        ProjectActivityLog[] // Project activity logging
  resources           ProjectResource[] // Project resources and attachments
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Project members junction table
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
}

enum ProjectRole {
  LEADER
  COORDINATOR
  MEMBER
}

// Project Milestone model
model ProjectMilestone {
  id                String                @id @default(cuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  dueDate           DateTime
  progress          Int                   @default(0) // Progress percentage 0-100
  status            MilestoneStatus       @default(PLANNED)
  responsibleUserId String?
  responsibleUser   User?                 @relation("MilestoneResponsible", fields: [responsibleUserId], references: [id])
  attachments       MilestoneAttachment[]
  subTasks          MilestoneSubTask[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  OVERDUE
}

// Milestone Sub-tasks
model MilestoneSubTask {
  id          String           @id @default(cuid())
  milestoneId String
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Milestone Attachments
model MilestoneAttachment {
  id           String           @id @default(cuid())
  milestoneId  String
  milestone    ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
}

// Daily Progress Updates
model ProjectProgressUpdate {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation("ProgressUpdateUser", fields: [userId], references: [id])
  taskActivity       String // Task/Activity completed
  progressPercentage Int // Percentage progress
  challenges         String? // Challenges encountered
  nextPlan           String? // Next day's plan
  attachment         String? // Attachment URL
  isApproved         Boolean   @default(false)
  approvedById       String?
  approvedBy         User?     @relation("ProgressApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  comments           String? // Project Lead comments
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Project Activity Log
model ProjectActivityLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectActivityUser", fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, ASSIGN, etc.
  details   Json? // Additional action details
  createdAt DateTime @default(now())
}

// Project Resources
model ProjectResource {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  uploadedById String
  uploadedBy   User     @relation("ProjectResourceUser", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// Enhanced Attendance & Work Tracking
model CheckIn {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  checkInTime  DateTime      @default(now())
  checkOutTime DateTime?
  notes        String?
  location     String?
  latitude     Float? // Geolocation support
  longitude    Float? // Geolocation support
  ipAddress    String?
  deviceInfo   String?
  workingHours Float? // Auto-calculated working hours
  status       CheckInStatus @default(CHECKED_IN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, checkInTime])
}

enum CheckInStatus {
  CHECKED_IN
  CHECKED_OUT
  INCOMPLETE
}

// Daily task logs for attendance tracking
model DailyTaskLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  date         DateTime
  description  String // What they worked on
  hoursSpent   Float?
  category     String? // Optional categorization
  attachments  String? // JSON array of attachment URLs
  isApproved   Boolean   @default(false)
  approvedById String?
  approvedBy   User?     @relation("TaskLogApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, date])
}

// Monthly work summaries
model WorkSummary {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  month          String // Format: YYYY-MM
  totalDays      Int      @default(0)
  daysPresent    Int      @default(0)
  daysAbsent     Int      @default(0)
  totalHours     Float    @default(0)
  tasksCompleted Int      @default(0)
  attendanceRate Float    @default(0) // Percentage
  summaryData    Json? // Additional stats
  generatedAt    DateTime @default(now())

  @@unique([userId, month])
  @@index([userId, month])
}

// Task assignees junction table
model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
}

// Document Category model
model DocumentCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  color       String?    @default("#4f46e5")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
}

// Document model
model Document {
  id               String            @id @default(cuid())
  title            String
  description      String?
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int?
  category         String?
  categoryId       String?
  documentCategory DocumentCategory? @relation(fields: [categoryId], references: [id])
  uploadedById     String
  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id])
  accessLevel      DocumentAccess    @default(ALL_STAFF)
  isPublic         Boolean           @default(false)
  tags             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum DocumentAccess {
  PUBLIC
  ALL_STAFF
  STAFF_ONLY
  ADMIN_ONLY
}

// Financial transaction model
model FinancialTransaction {
  id          String          @id @default(cuid())
  amount      Float
  description String?
  date        DateTime        @default(now())
  type        TransactionType
  category    String?
  reference   String?
  notes       String?
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
  DONATION
  GRANT
}

// Stipend model for employee/volunteer payments
model Stipend {
  id            String         @id @default(cuid())
  employeeId    String
  employee      User           @relation(fields: [employeeId], references: [id])
  amount        Float
  type          StipendType
  status        PaymentStatus  @default(PENDING)
  paymentDate   DateTime?
  paymentMethod PaymentMethod?
  remarks       String?
  department    String?
  approvedById  String?
  approvedBy    User?          @relation("StipendApproval", fields: [approvedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum StipendType {
  MONTHLY_STIPEND
  ALLOWANCE
  REIMBURSEMENT
  BONUS
  VOLUNTEER_ALLOWANCE
  TRANSPORT_ALLOWANCE
  MEAL_ALLOWANCE
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CHEQUE
}

// Expense request model
model ExpenseRequest {
  id          String          @id @default(cuid())
  requesterId String
  requester   User            @relation("ExpenseRequester", fields: [requesterId], references: [id])
  purpose     String
  category    ExpenseCategory
  amount      Float
  description String?
  status      ExpenseStatus   @default(PENDING)
  department  String?
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])

  // Approval workflow
  teamLeadId         String?
  teamLead           User?     @relation("ExpenseTeamLead", fields: [teamLeadId], references: [id])
  teamLeadApprovedAt DateTime?
  teamLeadNotes      String?

  financeApprovedById String?
  financeApprovedBy   User?     @relation("ExpenseFinanceApproval", fields: [financeApprovedById], references: [id])
  financeApprovedAt   DateTime?
  financeNotes        String?

  directorApprovedById String?
  directorApprovedBy   User?     @relation("ExpenseDirectorApproval", fields: [directorApprovedById], references: [id])
  directorApprovedAt   DateTime?
  directorNotes        String?

  // Payment details
  paidAt        DateTime?
  paidBy        String?
  paymentMethod PaymentMethod?
  voucherUrl    String? // PDF voucher URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attachments ExpenseAttachment[]
  comments    ExpenseComment[]
  budgetId    String?
  budget      DepartmentBudget?   @relation(fields: [budgetId], references: [id])
}

enum ExpenseCategory {
  TRANSPORT
  PRINTING
  OUTREACH_EVENT
  OFFICE_SUPPLIES
  COMMUNICATION
  TRAINING
  MEETING_EXPENSES
  EQUIPMENT
  MAINTENANCE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED_BY_TL
  APPROVED_BY_FINANCE
  REJECTED
  PAID
  CANCELLED
}

// Expense attachments
model ExpenseAttachment {
  id               String         @id @default(cuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int?
  uploadedById     String
  uploadedBy       User           @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime       @default(now())
}

// Expense comments
model ExpenseComment {
  id               String         @id @default(cuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id])
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Departmental budget model
model DepartmentBudget {
  id              String  @id @default(cuid())
  department      String
  budgetPeriod    String // e.g., "2025-01" for January 2025
  allocatedAmount Float
  spentAmount     Float   @default(0)
  remainingAmount Float
  isActive        Boolean @default(true)

  // Budget management
  createdById      String
  createdBy        User    @relation("BudgetCreator", fields: [createdById], references: [id])
  lastModifiedById String?
  lastModifiedBy   User?   @relation("BudgetModifier", fields: [lastModifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  adjustments BudgetAdjustment[]
  expenses    ExpenseRequest[]
}

// Budget adjustments for top-ups or reductions
model BudgetAdjustment {
  id           String           @id @default(cuid())
  budgetId     String
  budget       DepartmentBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  amount       Float
  type         AdjustmentType
  reason       String
  approvedById String
  approvedBy   User             @relation(fields: [approvedById], references: [id])
  createdAt    DateTime         @default(now())
}

enum AdjustmentType {
  TOP_UP
  REDUCTION
  CORRECTION
}

// Financial reports model
model FinancialReport {
  id            String     @id @default(cuid())
  reportType    ReportType
  period        String // e.g., "2025-01" for January 2025
  title         String
  description   String?
  fileUrl       String? // PDF report URL
  data          Json? // Report data as JSON
  generatedById String
  generatedBy   User       @relation(fields: [generatedById], references: [id])
  createdAt     DateTime   @default(now())
}

enum ReportType {
  MONTHLY_SUMMARY
  DEPARTMENTAL_REPORT
  EXPENSE_LEDGER
  STIPEND_REPORT
  BUDGET_ANALYSIS
  CUSTOM
}

// Client model
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  website   String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Team model for organizational structure
model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  @default("#4f46e5")
  icon        String? // Icon name for UI display
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members UserTeam[]
  tasks   TaskTeam[]
  kpis    KPI[]
  
  // Communication relations
  chatChannels   ChatChannel[]
  bulletinBoards BulletinBoard[]
}

// User-Team junction table (many-to-many)
model UserTeam {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([userId, teamId])
}

enum TeamRole {
  LEADER
  COORDINATOR
  MEMBER
}

// Task-Team junction table for team assignments
model TaskTeam {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, teamId])
}

// Employee Profile System
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  nationalId  String?   @unique
  phone       String?
  email       String?
  address     String?

  // Professional Information
  department     String?
  designation    String?
  supervisorId   String?
  supervisor     EmployeeProfile?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates   EmployeeProfile[] @relation("EmployeeSupervisor")
  employmentType EmploymentType    @default(FULL_TIME)
  startDate      DateTime?
  status         EmployeeStatus    @default(ACTIVE)

  // System Information
  employeeId   String  @unique // RYD-YYMM-XXXX format
  profilePhoto String?
  bio          String?

  // Relations
  documents          EmployeeDocument[]
  onboardingItems    OnboardingItem[]
  performanceReviews PerformanceReview[]
  leaveRequests      LeaveRequest[]
  attendanceRecords  AttendanceRecord[]
  privateNotes       PrivateNote[]
  timelineEvents     TimelineEvent[]
  welcomeNotes       WelcomeNote[]

  // Enhanced Leave & Performance relations
  leaveBalances LeaveBalance[]
  absenceAlerts AbsenceAlert[]
  kpis          KPI[]
  reviews360    Review360[]

  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  SUSPENDED
}

// Employee Document System
model EmployeeDocument {
