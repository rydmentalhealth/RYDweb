  title       String
  description String?
  category    OnboardingCategory @default(ORIENTATION)
  isRequired  Boolean            @default(true)
  isCompleted Boolean            @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum OnboardingCategory {
  ORIENTATION
  DOCUMENTATION
  TRAINING
  COMPLIANCE
  WELCOME
}

// Enhanced Performance & Evaluation Management
model PerformanceReview {
  id                  String          @id @default(cuid())
  employeeId          String
  employee            EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  rating              Int? // 1-5 scale
  goals               String?
  achievements        String?
  areasForImprovement String?
  reviewerId          String
  reviewer            User            @relation(fields: [reviewerId], references: [id])
  reviewDate          DateTime        @default(now())
  nextReviewDate      DateTime?
  reviewType          ReviewType      @default(SUPERVISOR)
  isCompleted         Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([employeeId, reviewDate])
}

enum ReviewType {
  SUPERVISOR
  PEER
  SELF
  THREE_SIXTY
}

// KPI Management
model KPI {
  id          String           @id @default(cuid())
  employeeId  String?
  employee    EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  target      Float
  current     Float            @default(0)
  unit        String? // e.g., "tasks", "hours", "%"
  category    KPICategory
  startDate   DateTime
  endDate     DateTime
  status      KPIStatus        @default(IN_PROGRESS)
  createdById String
  createdBy   User             @relation("KPICreator", fields: [createdById], references: [id])
  progress    Float            @default(0) // Percentage
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([employeeId, status])
  @@index([teamId, status])
}

enum KPICategory {
  TASK_COMPLETION
  PROJECT_DELIVERY
  ENGAGEMENT
  QUALITY
  INNOVATION
  TEAMWORK
  CUSTOM
}

enum KPIStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// 360° Review System
model Review360 {
  id         String          @id @default(cuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User            @relation("Review360Reviewer", fields: [reviewerId], references: [id])
  reviewType ReviewType360
  period     String // e.g., "2025-Q1"

  // Rating categories (1-5 scale)
  communicationRating   Int?
  teamworkRating        Int?
  leadershipRating      Int?
  technicalSkillsRating Int?
  problemSolvingRating  Int?
  initiativeRating      Int?
  overallRating         Float?

  // Comments
  strengths           String?
  areasForImprovement String?
  additionalComments  String?

  isAnonymous Boolean   @default(false)
  isCompleted Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, period])
  @@index([reviewerId, period])
}

enum ReviewType360 {
  SELF
  PEER
  SUPERVISOR
  SUBORDINATE
}

// Rewards & Recognition System
model RewardBadge {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  icon        String? // Icon name or emoji
  color       String        @default("#FFD700")
  points      Int           @default(0)
  category    BadgeCategory
  criteria    String? // Achievement criteria
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userRewards UserReward[]
}

enum BadgeCategory {
  EXCELLENCE
  LEADERSHIP
  INNOVATION
  TEAMWORK
  ATTENDANCE
  MILESTONE
  CUSTOM
}

// User rewards (junction table)
model UserReward {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       RewardBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedById String
  awardedBy   User        @relation("RewardGranter", fields: [awardedById], references: [id])
  reason      String?
  awardedAt   DateTime    @default(now())

  @@index([userId, awardedAt])
  @@index([badgeId])
}

// Enhanced Leave & Availability Management
model LeaveRequest {
  id            String           @id @default(cuid())
  employeeId    String
  employee      EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String?
  leaveType     LeaveTypeConfig? @relation(fields: [leaveTypeId], references: [id])
  type          LeaveType // Keep for backward compatibility
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  status        LeaveStatus      @default(PENDING)
  approvedById  String?
  approvedBy    User?            @relation(fields: [approvedById], references: [id])
  approvedAt    DateTime?
  comments      String?
  attachments   String? // Medical certificates, etc.
  handoverNotes String? // Work handover information
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

// Custom leave types configuration
model LeaveTypeConfig {
  id               String         @id @default(cuid())
  name             String         @unique
  code             String         @unique // e.g., SICK, ANNUAL
  description      String?
  defaultDays      Int            @default(0)
  color            String         @default("#4f46e5")
  requiresApproval Boolean        @default(true)
  requiresDocument Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  leaveRequests    LeaveRequest[]
}

// Leave balance tracking
model LeaveBalance {
  id         String          @id @default(cuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType
  year       Int
  allocated  Int             @default(0)
  used       Int             @default(0)
  remaining  Int             @default(0)
  carried    Int             @default(0) // Carried forward from previous year
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId, year])
}

// Absence alerts for HR
model AbsenceAlert {
  id         String          @id @default(cuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime?
  type       AbsenceType
  reason     String?
  isResolved Boolean         @default(false)
  notifiedAt DateTime        @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  notes      String?
  createdAt  DateTime        @default(now())

  @@index([employeeId, isResolved])
}

enum LeaveType {
  ANNUAL
  SICK
  STUDY
  COMPASSIONATE
  MATERNITY
  PATERNITY
  EMERGENCY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  UNPLANNED
  EXTENDED_LEAVE
  NO_SHOW
  LATE_ARRIVAL
}

// Attendance Management
model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  employee    EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

// Private Notes System
model PrivateNote {
  id             String          @id @default(cuid())
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  content        String
  authorId       String
  author         User            @relation(fields: [authorId], references: [id])
  isConfidential Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Timeline Events
model TimelineEvent {
  id          String            @id @default(cuid())
  employeeId  String
  employee    EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        TimelineEventType
  title       String
  description String?
  date        DateTime
  metadata    Json? // Store additional event-specific data
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
}

enum TimelineEventType {
  JOINED
  PROMOTION
  ROLE_CHANGE
  DEPARTMENT_CHANGE
  RECOGNITION
  TRAINING
  LEAVE
  RETURN
  TERMINATION
  OTHER
}

// Activity Log for RBAC
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // CREATE, UPDATE, DELETE, VIEW, etc.
  resource   String // employee, document, etc.
  resourceId String? // ID of the affected resource
  details    Json? // Additional action details
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

// Welcome Notes
model WelcomeNote {
  id         String          @id @default(cuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  content    String
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  isVisible  Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ============================================================================
// INTERNAL COMMUNICATION MODULE - RYD Connect Center
// ============================================================================

// Chat Channels (Groups and Direct Messages)
model ChatChannel {
  id          String      @id @default(cuid())
  name        String? // Null for DMs, set for groups
  description String?
  type        ChannelType @default(DIRECT)
  isActive    Boolean     @default(true)
  
  // Channel settings
  avatar      String? // Group avatar URL
  settings    Json? // Channel-specific settings (notifications, permissions, etc.)
  
  // Department/Team association
  departmentId String?
  department   Team?   @relation(fields: [departmentId], references: [id])
  
  // Auto-generated groups
  isAutoGenerated Boolean @default(false) // For department auto-groups
  
  // Relations
  members     ChatMember[]
  messages    ChatMessage[]
  pinnedPosts PinnedMessage[]
  
  // Audit
  createdById String?
  createdBy   User?    @relation("ChatChannelCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type, isActive])
  @@index([departmentId])
}

enum ChannelType {
  DIRECT      // 1-on-1 DM
  GROUP       // Custom group chat
  DEPARTMENT  // Department-wide chat
  PROJECT     // Project-specific chat
  ANNOUNCEMENT // Announcement-only channel
}

// Chat Channel Members
model ChatMember {
  id        String           @id @default(cuid())
  channelId String
  channel   ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatMemberRole   @default(MEMBER)
  
  // Member settings
  isMuted         Boolean   @default(false)
  lastReadAt      DateTime? // For unread count
  notificationLevel NotificationLevel @default(ALL)
  
  // Audit
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  
  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId, lastReadAt])
}

enum ChatMemberRole {
  ADMIN   // Can manage channel, add/remove members
  MODERATOR // Can pin messages, moderate content
  MEMBER  // Regular member
}

enum NotificationLevel {
  ALL       // All messages
  MENTIONS  // Only @mentions
  NONE      // No notifications
}

// Chat Messages
model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  
  // Message content
  content     String
  messageType MessageType @default(TEXT)
  
  // Rich content
  attachments Json? // Array of file attachments
  mentions    Json? // Array of mentioned user IDs
  metadata    Json? // Additional message metadata
  
  // Message threading
  replyToId   String?
  replyTo     ChatMessage? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChatMessage[] @relation("MessageReplies")
  
  // Message status
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  
  // Reactions
  reactions   MessageReaction[]
  
  // Pinned messages
  pinnedIn    PinnedMessage[]
  
  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([channelId, createdAt])
  @@index([authorId])
  @@index([replyToId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE_NOTE
  SYSTEM      // System messages (user joined, left, etc.)
  ANNOUNCEMENT
}

// Message Reactions (Emojis)
model MessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      // Emoji unicode or name
  createdAt DateTime    @default(now())
  
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Pinned Messages in Channels
model PinnedMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User        @relation(fields: [pinnedById], references: [id])
  pinnedAt   DateTime    @default(now())
  
  @@unique([channelId, messageId])
  @@index([channelId])
}

// Organization-wide Announcements & Newsfeed
model Announcement {
  id       String           @id @default(cuid())
  title    String
  content  String
  type     AnnouncementType @default(GENERAL)
  priority AnnouncementPriority @default(NORMAL)
  
  // Rich content
  attachments Json? // Images, videos, files
  tags        Json? // Array of tags
  
  // Targeting
  targetAudience Json? // Array of roles, departments, or specific users
  isPublic       Boolean @default(true)
  
  // Engagement
  allowComments  Boolean @default(true)
  allowReactions Boolean @default(true)
  
  // Status
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime? // Auto-hide after date
  isPinned    Boolean   @default(false)
  pinnedUntil DateTime?
  
  // Relations
  comments  AnnouncementComment[]
  reactions AnnouncementReaction[]
  views     AnnouncementView[]
  
  // Audit
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([isPublished, publishedAt])
  @@index([type, priority])
  @@index([isPinned, pinnedUntil])
}

enum AnnouncementType {
  GENERAL
  URGENT
  POLICY
  EVENT
  ACHIEVEMENT
  BIRTHDAY
  NEW_MEMBER
  PROJECT_UPDATE
  TRAINING
  DEADLINE
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Announcement Comments
model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  content        String
  
  // Threading
  parentId String?
  parent   AnnouncementComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  AnnouncementComment[] @relation("CommentReplies")
  
  // Status
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([announcementId, createdAt])
  @@index([authorId])
}

// Announcement Reactions
model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String       // Emoji unicode or name
  createdAt      DateTime     @default(now())
  
  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
}

// Announcement Views (for analytics)
model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now())
  
  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId, viewedAt])
}

// Departmental Bulletin Boards
model BulletinBoard {
  id          String  @id @default(cuid())
  name        String
  description String?
  
  // Department association
  departmentId String?
  department   Team?   @relation(fields: [departmentId], references: [id])
  
  // Access control
  isPublic    Boolean @default(false)
  accessRoles Json?   // Array of roles that can access
  
  // Settings
  allowComments Boolean @default(true)
  isActive      Boolean @default(true)
  
  // Relations
  posts BulletinPost[]
  
  // Audit
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([departmentId, isActive])
  @@index([isPublic])
}

// Bulletin Board Posts
model BulletinPost {
  id            String        @id @default(cuid())
  bulletinId    String
  bulletin      BulletinBoard @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  title         String
  content       String
  type          PostType      @default(NOTICE)
  
  // Rich content
  attachments Json? // Files, links, images
  tags        Json? // Array of tags
  
  // Status
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime? // Auto-archive after date
  isPinned    Boolean   @default(false)
  
  // Engagement
  allowComments Boolean @default(true)
  
  // Relations
  comments BulletinComment[]
  views    BulletinView[]
  
  // Audit
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([bulletinId, isPublished, publishedAt])
  @@index([type, isPinned])
}

enum PostType {
  NOTICE
  GUIDELINE
  TASK
  MEETING
  DOCUMENT
  FORM
  ANNOUNCEMENT
}

// Bulletin Post Comments
model BulletinComment {
  id      String       @id @default(cuid())
  postId  String
  post    BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User         @relation(fields: [authorId], references: [id])
  content  String
  
  // Status
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([postId, createdAt])
}

// Bulletin Post Views (for "Seen" indicators)
model BulletinView {
  id       String       @id @default(cuid())
  postId   String
  post     BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime     @default(now())
  
  @@unique([postId, userId])
  @@index([postId])
}

// Polls & Surveys for Engagement
model Poll {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        PollType   @default(SINGLE_CHOICE)
  
  // Settings
  isAnonymous   Boolean   @default(false)
  allowComments Boolean   @default(true)
  isActive      Boolean   @default(true)
  
  // Timing
  startsAt DateTime  @default(now())
  endsAt   DateTime?
  
  // Targeting
  targetAudience Json? // Array of roles, departments, or specific users
  
  // Relations
  options  PollOption[]
  votes    PollVote[]
  comments PollComment[]
  
  // Audit
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive, endsAt])
  @@index([createdById])
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  TEXT_RESPONSE
}

// Poll Options
model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int    @default(0)
  
  // Relations
  votes PollVote[]
  
  @@index([pollId, order])
}

// Poll Votes
model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String?
  option   PollOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // For text responses
  textResponse String?
  
  votedAt DateTime @default(now())
  
  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

// Poll Comments
model PollComment {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([pollId, createdAt])
}

// Notification System
model Notification {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     NotificationType
  title    String
  content  String?
  
  // Rich content
  data     Json? // Additional notification data
  actionUrl String? // URL to navigate to when clicked
  
  // Status
  isRead   Boolean   @default(false)
  readAt   DateTime?
  
  // Grouping
  category String? // For grouping related notifications
  
  createdAt DateTime @default(now())
  
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}

enum NotificationType {
  CHAT_MESSAGE
  CHAT_MENTION
  ANNOUNCEMENT
  BULLETIN_POST
  POLL_CREATED
  COMMENT_REPLY
  SYSTEM
  RECOGNITION
  TASK_ASSIGNED
  PROJECT_UPDATE
  LEAVE_APPROVED
  BIRTHDAY
  WELCOME
}

// User Notification Preferences
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Channel preferences
  emailNotifications    Boolean @default(true)
  pushNotifications     Boolean @default(true)
  desktopNotifications  Boolean @default(true)
  
  // Type preferences
  chatMessages          Boolean @default(true)
  chatMentions          Boolean @default(true)
  announcements         Boolean @default(true)
  bulletinPosts         Boolean @default(true)
  polls                 Boolean @default(true)
  comments              Boolean @default(true)
  recognition           Boolean @default(true)
  taskUpdates           Boolean @default(true)
  projectUpdates        Boolean @default(true)
  
  // Timing preferences
  quietHoursStart String? // e.g., "22:00"
  quietHoursEnd   String? // e.g., "08:00"
  timezone        String? @default("UTC")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Communication Analytics
model CommunicationAnalytics {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Daily stats
  date              DateTime @db.Date
  messagesPosted    Int      @default(0)
  messagesReceived  Int      @default(0)
  announcementsRead Int      @default(0)
  pollsParticipated Int      @default(0)
  commentsPosted    Int      @default(0)
  
  // Engagement metrics
  reactionsGiven    Int @default(0)
  reactionsReceived Int @default(0)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, date])
  @@index([date])
}
